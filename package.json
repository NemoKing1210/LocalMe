{
  "name": "localme",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "description": "LocalMe — a zero-configuration messenger for the local network, built with Tauri 2, Rust and Vue 3.",
  "license": "MIT",
  "author": "LocalMe contributors",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build --force && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build --force",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:scripts": "node --test scripts/lib/versions.test.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "changelog": "node scripts/extract-changelog.mjs",
    "version:patch": "node scripts/bump-version.mjs patch",
    "version:minor": "node scripts/bump-version.mjs minor",
    "version:major": "node scripts/bump-version.mjs major",
    "release": "node scripts/release.mjs",
    "ci": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run test:scripts && npm run build && npm run check:versions",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@material/material-color-utilities": "0.4.0",
    "@tanstack/vue-virtual": "3.13.39",
    "@tauri-apps/api": "2.12.0",
    "@tauri-apps/plugin-autostart": "2.6.0",
    "@tauri-apps/plugin-notification": "2.5.0",
    "@tauri-apps/plugin-os": "2.4.0",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-store": "2.5.0",
    "@vue/devtools-api": "8.2.1",
    "blobatar": "2.7.0",
    "motion-v": "^2.5.1",
    "pinia": "4.0.3",
    "vue": "3.5.43",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "2.12.0",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.11.0",
    "eslint-plugin-vue": "10.11.1",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.11"
  }
}
